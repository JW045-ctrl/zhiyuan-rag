{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiyuan.local/schemas/rag-test-cases.schema.json",
  "title": "知源 RAG 测试集",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "course", "description", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "const": "1.0" },
    "course": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "enabled",
          "question",
          "expected_behavior",
          "expected_documents",
          "reference_answer",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "enabled": { "type": "boolean" },
          "question": { "type": "string" },
          "expected_behavior": {
            "type": "string",
            "enum": ["ANSWER", "REFUSE"]
          },
          "expected_documents": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "reference_answer": { "type": "string" },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
